{
  "name": "xtremeled-remap-export",
  "productName": "XtremeLED Remap Export",
  "version": "1.1.0",
  "description": "Remap stageview renders naar LED output mappings (Resolume-compatible)",
  "author": "XtremeLED",
  "license": "UNLICENSED",
  "main": "main.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "prestart": "node tools/check-install.js",
    "start": "electron .",
    "test": "node test/run-tests.js",
    "screenshot": "electron . --screenshot=/tmp/xre-screenshot.png",
    "fetch-ffmpeg": "node tools/fetch-ffmpeg.js",
    "postinstall": "node tools/patch-electron-name.js && node tools/check-install.js"
  },
  "devDependencies": {
    "electron": "^43.8.7",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "build": {
    "appId": "nl.xtremeled.remapexport",
    "productName": "XtremeLED Remap Export",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "afterPack": "tools/afterPack.js",
    "files": [
      "**/*",
      "!examples/**",
      "!test/**",
      "!docs/**",
      "!dist/**",
      "!tools/**",
      "!licenses/**",
      "!.github/**",
      "!*.command",
      "!node_modules/ffmpeg-static/**",
      "!bin/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "bin/ffmpeg-dxv/ffmpeg-x64",
          "to": "bin/ffmpeg-dxv/ffmpeg-x64"
        },
        {
          "from": "bin/ffmpeg-dxv/ffmpeg-arm64",
          "to": "bin/ffmpeg-dxv/ffmpeg-arm64"
        },
        {
          "from": "licenses",
          "to": "licenses"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "bin/ffmpeg-dxv/ffmpeg-win64.exe",
          "to": "bin/ffmpeg-dxv/ffmpeg-win64.exe"
        },
        {
          "from": "licenses",
          "to": "licenses"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@43.8.7": true,
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true
  }
}
