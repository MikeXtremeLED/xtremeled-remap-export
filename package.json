{
  "name": "xtremeled-remap-export",
  "productName": "XtremeLED Remap Export",
  "version": "1.0.0",
  "description": "Remap stageview renders naar LED output mappings (Resolume-compatible)",
  "author": "XtremeLED",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "screenshot": "electron . --screenshot=/tmp/xre-screenshot.png",
    "postinstall": "node tools/patch-electron-name.js"
  },
  "devDependencies": {
    "electron": "^31.7.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "build": {
    "appId": "nl.xtremeled.remapexport",
    "productName": "XtremeLED Remap Export",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "afterPack": "tools/afterPack.js",
    "asarUnpack": [
      "bin/**"
    ],
    "files": [
      "**/*",
      "!examples/**",
      "!test/**",
      "!docs/**",
      "!dist/**",
      "!*.command",
      "!node_modules/ffmpeg-static/**",
      "!bin/ffmpeg-dxv/ffmpeg"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "files": [
        "!bin/ffmpeg-dxv/ffmpeg-win64.exe"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "files": [
        "!bin/ffmpeg-dxv/ffmpeg-x64",
        "!bin/ffmpeg-dxv/ffmpeg-arm64"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
