{
  "name": "xtremeled-remap-export",
  "productName": "XtremeLED Remap Export",
  "version": "1.0.1",
  "description": "Remap stageview renders naar LED output mappings (Resolume-compatible)",
  "author": "XtremeLED",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "screenshot": "electron . --screenshot=/tmp/xre-screenshot.png",
    "postinstall": "node tools/patch-electron-name.js"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "build": {
    "appId": "nl.xtremeled.remapexport",
    "productName": "XtremeLED Remap Export",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "afterPack": "tools/afterPack.js",
    "files": [
      "**/*",
      "!examples/**",
      "!test/**",
      "!docs/**",
      "!dist/**",
      "!tools/**",
      "!*.command",
      "!node_modules/ffmpeg-static/**",
      "!bin/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "bin/ffmpeg-dxv/ffmpeg-x64",
          "to": "bin/ffmpeg-dxv/ffmpeg-x64"
        },
        {
          "from": "bin/ffmpeg-dxv/ffmpeg-arm64",
          "to": "bin/ffmpeg-dxv/ffmpeg-arm64"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "bin/ffmpeg-dxv/ffmpeg-win64.exe",
          "to": "bin/ffmpeg-dxv/ffmpeg-win64.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
